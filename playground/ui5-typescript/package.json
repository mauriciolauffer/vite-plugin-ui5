    "start": "ui5 serve --port 8080",
    "ts-typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openui5/types": "1.148.0",
    "@types/qunit": "2.19.14",
    "@ui5/cli": "^4",
    "ui5-tooling-transpile": "3.11.2",
    "vite": "^8",
    "vite-plugin-ui5": "link:../.."
  },
  "engines": {
    "node": ">=22"
  }
}
