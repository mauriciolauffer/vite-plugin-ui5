{
  "name": "vite-plugin-ui5",
  "version": "0.1.0",
  "description": "Modern Vite development server and tooling platform for SAPUI5 and OpenUI5 applications.",
  "keywords": [
    "fiori",
    "openui5",
    "sapui5",
    "ui5",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "author": "Mauricio Lauffer",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxfmt --check && oxlint",
    "format": "oxfmt",
    "dev:ui5": "pnpm --filter ui5-app run dev",
    "dev:ui5:esm": "pnpm --filter ui5-app-esm run dev",
    "dev:ui5:ts": "pnpm --filter ui5-app run dev"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "babel-plugin-transform-modules-ui5": "^7.10.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.4",
    "@ui5/cli": "^4.0.70",
    "@vitejs/devtools": "^0.7.6",
    "@vitejs/devtools-oxc": "^0.7.6",
    "@vitejs/devtools-rolldown": "^0.7.6",
    "@vitejs/devtools-vite": "^0.7.6",
    "@vitejs/devtools-vitest": "^0.7.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vite": "^8"
  },
  "packageManager": "pnpm@12.10.1"
}
